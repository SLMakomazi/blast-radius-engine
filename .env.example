# Deliberately synthetic local-lab values only; never use production credentials.
POSTGRES_DB=synthetic_lab
POSTGRES_USER=synthetic_lab
POSTGRES_PASSWORD=synthetic-local-only
REQUEST_INTERVAL=2
TRAFFIC_ENABLED=true

# Independent Blast Radius incident store. It must remain available when the
# synthetic target PostgreSQL service is intentionally stopped.
BLAST_RADIUS_DB_NAME=blast_radius
BLAST_RADIUS_DB_USER=blast_radius
BLAST_RADIUS_DB_PASSWORD=blast-radius-local-only
