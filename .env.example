# Required: choose your own database settings and a stable volume name.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_VOLUME_NAME=
MONITOR_APPLICATION_ID=
MONITOR_ENVIRONMENT=

# Published ports. Use 0.0.0.0 when your hosting environment needs public binding.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173

# Built into the browser bundle. Empty uses the frontend's /api/ proxy.
VITE_API_BASE_URL=
TOPOLOGY_REFRESH_ENABLED=false
